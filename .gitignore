# ==============================================================================
# SentiPulse Sentiment Analysis & MLOps Platform — Hardened .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Credentials & Sensitive Configurations
# ------------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
*.pub
*.credentials
kaggle.json
*token*
client_secrets.json
credentials.json
local_settings.py
secrets.json

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caching & Compilation
# ------------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# ------------------------------------------------------------------------------
# 4. Databases, SQLite Telemetry & WAL Journal Files
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
monitoring.db
monitoring.db-wal
monitoring.db-shm
db.sqlite3
db.sqlite3-journal

# ------------------------------------------------------------------------------
# 5. Machine Learning Models, Heavy Weights & Checkpoints
# ------------------------------------------------------------------------------
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.bin
*.h5
*.ckpt
*.weights
*.safetensors
*.safetensors.index.json
*.onnx
*.onnx.clean.onnx
checkpoints/
runs/
wandb/

# Preserve lightweight deployment compressed artifact & model metadata
!data/models/transformer_sentiment/model_quantized.onnx.gz
!data/models/transformer_sentiment/*.json

# ------------------------------------------------------------------------------
# 6. Raw & Processed Datasets, Large Data Archives
# ------------------------------------------------------------------------------
*.csv
*.csv.gz
*.tsv
*.parquet
*.feather
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
Reviews.csv
Reviews.csv.zip
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ------------------------------------------------------------------------------
# 7. Testing, Coverage, Benchmarks & Metrics
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
benchmark_report.txt
benchmark*.txt

# ------------------------------------------------------------------------------
# 8. Temporary Visualization Plots & Images
# ------------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.svg
*.pdf
# Allow web dashboard static assets and documentation graphics
!src/api/static/**
!docs/**
!extension/icons/**

# ------------------------------------------------------------------------------
# 9. Logs & Process Artifacts
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
!logs/.gitkeep
pip-log.txt
pip-delete-this-directory.txt
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# 10. Agent State, IDEs & OS Metadata
# ------------------------------------------------------------------------------
.agents/
.agent/
.gemini/
.cursor/
.claude/
.antigravity/
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
/site
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
profile_default/
ipython_config.py
