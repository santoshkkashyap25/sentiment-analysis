# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Git and IDE
.git/
.github/
.gitignore
.vscode/
.idea/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

